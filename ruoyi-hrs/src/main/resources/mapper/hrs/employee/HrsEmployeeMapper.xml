    <update id="updateHrsEmployeeWorkYears" parameterType="Long">
        update hrs_employee
        set work_years = round(datediff(curdate(), work_date) / 365, 2)
        where employee_id = #{employeeId}
    </update>

    <delete id="deleteHrsEmployeeByEmployeeId" parameterType="Long">
        update hrs_employee set del_flag = '2' where employee_id = #{employeeId}
    </delete>

    <delete id="deleteHrsEmployeeByEmployeeIds" parameterType="String">
        update hrs_employee set del_flag = '2' where employee_id in 
