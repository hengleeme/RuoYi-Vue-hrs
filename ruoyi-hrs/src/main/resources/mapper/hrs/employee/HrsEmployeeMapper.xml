    <sql id="selectHrsEmployeeVo">
        select employee_id, employee_no, employee_name, gender, birthday, id_card, political_status, nation, marital_status, education, degree, graduate_school, major, graduate_date, work_date, entry_date, dept_id, dept_name, position_id, position_name, job_level, job_title, phone, email, address, registered_address, emergency_contact, emergency_phone, status, del_flag, work_years, create_by, create_time, update_by, update_time, remark
        from hrs_employee
    </sql>

    <select id="selectHrsEmployeeList" parameterType="HrsEmployee" resultMap="HrsEmployeeResult">
        <include refid="selectHrsEmployeeVo"/>
        <where>  
            <if test="employeeNo != null  and employeeNo != ''"> and employee_no like concat('%', #{employeeNo}, '%')</if>
            <if test="employeeName != null  and employeeName != ''"> and employee_name like concat('%', #{employeeName}, '%')</if>
            <if test="gender != null  and gender != ''"> and gender = #{gender}</if>
            <if test="idCard != null  and idCard != ''"> and id_card = #{idCard}</if>
            <if test="politicalStatus != null  and politicalStatus != ''"> and political_status = #{politicalStatus}</if>
            <if test="nation != null  and nation != ''"> and nation = #{nation}</if>
            <if test="maritalStatus != null  and maritalStatus != ''"> and marital_status = #{maritalStatus}</if>
            <if test="education != null  and education != ''"> and education = #{education}</if>
            <if test="degree != null  and degree != ''"> and degree = #{degree}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="positionId != null "> and position_id = #{positionId}</if>
            <if test="jobLevel != null  and jobLevel != ''"> and job_level = #{jobLevel}</if>
            <if test="jobTitle != null  and jobTitle != ''"> and job_title = #{jobTitle}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            and del_flag = '0'
        </where>
        order by employee_no
    </select>
    
    <select id="selectHrsEmployeeByEmployeeId" parameterType="Long" resultMap="HrsEmployeeResult">
        <include refid="selectHrsEmployeeVo"/>
        where employee_id = #{employeeId}
    </select>

    <select id="selectHrsEmployeeByEmployeeNo" parameterType="String" resultMap="HrsEmployeeResult">
        <include refid="selectHrsEmployeeVo"/>
        where employee_no = #{employeeNo} and del_flag = '0'
    </select>

    <select id="selectHrsEmployeeByIdCard" parameterType="String" resultMap="HrsEmployeeResult">
        <include refid="selectHrsEmployeeVo"/>
        where id_card = #{idCard} and del_flag = '0'
    </select>
        
