<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.henglee.hrp.hrs.mapper.EmployeeTypeMapper">
    
    <resultMap type="EmployeeType" id="EmployeeTypeResult">
        <result property="typeId"    column="type_id"    />
        <result property="typeName"  column="type_name"  />
        <result property="typeCode"  column="type_code"  />
        <result property="status"    column="status"     />
        <result property="remark"    column="remark"     />
        <result property="createBy"  column="create_by"  />
        <result property="createTime" column="create_time"/>
        <result property="updateBy"  column="update_by"  />
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectEmployeeTypeVo">
        select type_id, type_name, type_code, status, remark, create_by, create_time, update_by, update_time
        from hrs_employee_type
    </sql>

    <select id="selectEmployeeTypeList" parameterType="EmployeeType" resultMap="EmployeeTypeResult">
        <include refid="selectEmployeeTypeVo"/>
        <where>  
            <if test="typeName != null  and typeName != ''"> and type_name like concat('%', #{typeName}, '%')</if>
            <if test="typeCode != null  and typeCode != ''"> and type_code = #{typeCode}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectEmployeeTypeByTypeId" parameterType="Long" resultMap="EmployeeTypeResult">
        <include refid="selectEmployeeTypeVo"/>
        where type_id = #{typeId}
    </select>
        
    <insert id="insertEmployeeType" parameterType="EmployeeType" useGeneratedKeys="true" keyProperty="typeId">
        insert into hrs_employee_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="typeName != null">type_name,</if>
            <if test="typeCode != null">type_code,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="typeName != null">#{typeName},</if>
            <if test="typeCode != null">#{typeCode},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEmployeeType" parameterType="EmployeeType">
        update hrs_employee_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="typeName != null">type_name = #{typeName},</if>
            <if test="typeCode != null">type_code = #{typeCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where type_id = #{typeId}
    </update>

    <delete id="deleteEmployeeTypeByTypeId" parameterType="Long">
        delete from hrs_employee_type where type_id = #{typeId}
    </delete>

    <delete id="deleteEmployeeTypeByTypeIds" parameterType="String">
        delete from hrs_employee_type where type_id in 
        <foreach item="typeId" collection="array" open="(" separator="," close=")">
            #{typeId}
        </foreach>
    </delete>
</mapper> 