<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.henglee.hrp.hrs.salary.mapper.HrsSalaryInfoMapper">
    
    <resultMap type="HrsSalaryInfo" id="HrsSalaryInfoResult">
        <result property="salaryId"    column="salary_id"    />
        <result property="employeeId"    column="employee_id"    />
        <result property="employeeName"    column="employee_name"    />
        <result property="deptName"    column="dept_name"    />
        <result property="salaryYear"    column="salary_year"    />
        <result property="salaryMonth"    column="salary_month"    />
        <result property="basicSalary"    column="basic_salary"    />
        <result property="positionSalary"    column="position_salary"    />
        <result property="performanceSalary"    column="performance_salary"    />
        <result property="overtimeSalary"    column="overtime_salary"    />
        <result property="bonus"    column="bonus"    />
        <result property="subsidy"    column="subsidy"    />
        <result property="socialSecurity"    column="social_security"    />
        <result property="housingFund"    column="housing_fund"    />
        <result property="tax"    column="tax"    />
        <result property="otherDeduction"    column="other_deduction"    />
        <result property="actualSalary"    column="actual_salary"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectHrsSalaryInfoVo">
        select s.salary_id, s.employee_id, e.employee_name, d.dept_name, s.salary_year, s.salary_month, 
        s.basic_salary, s.position_salary, s.performance_salary, s.overtime_salary, s.bonus, s.subsidy,
        s.social_security, s.housing_fund, s.tax, s.other_deduction, s.actual_salary, s.status, s.del_flag,
        s.create_by, s.create_time, s.update_by, s.update_time, s.remark
        from hrs_salary_info s
        left join hrs_employee e on e.employee_id = s.employee_id
        left join sys_dept d on d.dept_id = e.dept_id
    </sql>

    <select id="selectHrsSalaryInfoList" parameterType="HrsSalaryInfo" resultMap="HrsSalaryInfoResult">
        <include refid="selectHrsSalaryInfoVo"/>
        <where>  
            <if test="employeeId != null "> and s.employee_id = #{employeeId}</if>
            <if test="employeeName != null  and employeeName != ''"> and e.employee_name like concat('%', #{employeeName}, '%')</if>
            <if test="deptName != null  and deptName != ''"> and d.dept_name like concat('%', #{deptName}, '%')</if>
            <if test="salaryYear != null "> and s.salary_year = #{salaryYear}</if>
            <if test="salaryMonth != null "> and s.salary_month = #{salaryMonth}</if>
            <if test="status != null  and status != ''"> and s.status = #{status}</if>
        </where>
    </select>
    
    <select id="selectHrsSalaryInfoBySalaryId" parameterType="Long" resultMap="HrsSalaryInfoResult">
        <include refid="selectHrsSalaryInfoVo"/>
        where s.salary_id = #{salaryId}
    </select>
        
    <insert id="insertHrsSalaryInfo" parameterType="HrsSalaryInfo" useGeneratedKeys="true" keyProperty="salaryId">
        insert into hrs_salary_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">employee_id,</if>
            <if test="salaryYear != null">salary_year,</if>
            <if test="salaryMonth != null">salary_month,</if>
            <if test="basicSalary != null">basic_salary,</if>
            <if test="positionSalary != null">position_salary,</if>
            <if test="performanceSalary != null">performance_salary,</if>
            <if test="overtimeSalary != null">overtime_salary,</if>
            <if test="bonus != null">bonus,</if>
            <if test="subsidy != null">subsidy,</if>
            <if test="socialSecurity != null">social_security,</if>
            <if test="housingFund != null">housing_fund,</if>
            <if test="tax != null">tax,</if>
            <if test="otherDeduction != null">other_deduction,</if>
            <if test="actualSalary != null">actual_salary,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">#{employeeId},</if>
            <if test="salaryYear != null">#{salaryYear},</if>
            <if test="salaryMonth != null">#{salaryMonth},</if>
            <if test="basicSalary != null">#{basicSalary},</if>
            <if test="positionSalary != null">#{positionSalary},</if>
            <if test="performanceSalary != null">#{performanceSalary},</if>
            <if test="overtimeSalary != null">#{overtimeSalary},</if>
            <if test="bonus != null">#{bonus},</if>
            <if test="subsidy != null">#{subsidy},</if>
            <if test="socialSecurity != null">#{socialSecurity},</if>
            <if test="housingFund != null">#{housingFund},</if>
            <if test="tax != null">#{tax},</if>
            <if test="otherDeduction != null">#{otherDeduction},</if>
            <if test="actualSalary != null">#{actualSalary},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateHrsSalaryInfo" parameterType="HrsSalaryInfo">
        update hrs_salary_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="employeeId != null">employee_id = #{employeeId},</if>
            <if test="salaryYear != null">salary_year = #{salaryYear},</if>
            <if test="salaryMonth != null">salary_month = #{salaryMonth},</if>
            <if test="basicSalary != null">basic_salary = #{basicSalary},</if>
            <if test="positionSalary != null">position_salary = #{positionSalary},</if>
            <if test="performanceSalary != null">performance_salary = #{performanceSalary},</if>
            <if test="overtimeSalary != null">overtime_salary = #{overtimeSalary},</if>
            <if test="bonus != null">bonus = #{bonus},</if>
            <if test="subsidy != null">subsidy = #{subsidy},</if>
            <if test="socialSecurity != null">social_security = #{socialSecurity},</if>
            <if test="housingFund != null">housing_fund = #{housingFund},</if>
            <if test="tax != null">tax = #{tax},</if>
            <if test="otherDeduction != null">other_deduction = #{otherDeduction},</if>
            <if test="actualSalary != null">actual_salary = #{actualSalary},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where salary_id = #{salaryId}
    </update>

    <delete id="deleteHrsSalaryInfoBySalaryId" parameterType="Long">
        delete from hrs_salary_info where salary_id = #{salaryId}
    </delete>

    <delete id="deleteHrsSalaryInfoBySalaryIds" parameterType="String">
        delete from hrs_salary_info where salary_id in 
        <foreach item="salaryId" collection="array" open="(" separator="," close=")">
            #{salaryId}
        </foreach>
    </delete>

    <update id="submitHrsSalaryInfo" parameterType="Long">
        update hrs_salary_info set status = '1' where salary_id = #{salaryId}
    </update>

    <update id="approveHrsSalaryInfo" parameterType="HrsSalaryInfo">
        update hrs_salary_info set status = '2', update_by = #{updateBy}, update_time = sysdate() where salary_id = #{salaryId}
    </update>

    <update id="payHrsSalaryInfo" parameterType="Long">
        update hrs_salary_info set status = '3' where salary_id = #{salaryId}
    </update>
</mapper> 