<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.henglee.hrp.hrs.salary.mapper.HrsSalaryStandardMapper">
    
    <resultMap type="HrsSalaryStandard" id="HrsSalaryStandardResult">
        <result property="standardId"    column="standard_id"    />
        <result property="standardName"    column="standard_name"    />
        <result property="standardType"    column="standard_type"    />
        <result property="standardValue"    column="standard_value"    />
        <result property="standardUnit"    column="standard_unit"    />
        <result property="standardDesc"    column="standard_desc"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectHrsSalaryStandardVo">
        select standard_id, standard_name, standard_type, standard_value, standard_unit, standard_desc, status, del_flag, create_by, create_time, update_by, update_time, remark
        from hrs_salary_standard
    </sql>

    <select id="selectHrsSalaryStandardList" parameterType="HrsSalaryStandard" resultMap="HrsSalaryStandardResult">
        <include refid="selectHrsSalaryStandardVo"/>
        <where>  
            <if test="standardName != null  and standardName != ''"> and standard_name like concat('%', #{standardName}, '%')</if>
            <if test="standardType != null  and standardType != ''"> and standard_type = #{standardType}</if>
            <if test="standardValue != null "> and standard_value = #{standardValue}</if>
            <if test="standardUnit != null  and standardUnit != ''"> and standard_unit = #{standardUnit}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectHrsSalaryStandardByStandardId" parameterType="Long" resultMap="HrsSalaryStandardResult">
        <include refid="selectHrsSalaryStandardVo"/>
        where standard_id = #{standardId}
    </select>
        
    <insert id="insertHrsSalaryStandard" parameterType="HrsSalaryStandard" useGeneratedKeys="true" keyProperty="standardId">
        insert into hrs_salary_standard
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="standardName != null">standard_name,</if>
            <if test="standardType != null">standard_type,</if>
            <if test="standardValue != null">standard_value,</if>
            <if test="standardUnit != null">standard_unit,</if>
            <if test="standardDesc != null">standard_desc,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="standardName != null">#{standardName},</if>
            <if test="standardType != null">#{standardType},</if>
            <if test="standardValue != null">#{standardValue},</if>
            <if test="standardUnit != null">#{standardUnit},</if>
            <if test="standardDesc != null">#{standardDesc},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateHrsSalaryStandard" parameterType="HrsSalaryStandard">
        update hrs_salary_standard
        <trim prefix="SET" suffixOverrides=",">
            <if test="standardName != null">standard_name = #{standardName},</if>
            <if test="standardType != null">standard_type = #{standardType},</if>
            <if test="standardValue != null">standard_value = #{standardValue},</if>
            <if test="standardUnit != null">standard_unit = #{standardUnit},</if>
            <if test="standardDesc != null">standard_desc = #{standardDesc},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where standard_id = #{standardId}
    </update>

    <delete id="deleteHrsSalaryStandardByStandardId" parameterType="Long">
        delete from hrs_salary_standard where standard_id = #{standardId}
    </delete>

    <delete id="deleteHrsSalaryStandardByStandardIds" parameterType="String">
        delete from hrs_salary_standard where standard_id in 
        <foreach item="standardId" collection="array" open="(" separator="," close=")">
            #{standardId}
        </foreach>
    </delete>
</mapper> 