<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.henglee.hrp.hrs.mapper.EmployeeCodeRuleMapper">
    
    <resultMap type="EmployeeCodeRule" id="EmployeeCodeRuleResult">
        <result property="ruleId"    column="rule_id"    />
        <result property="ruleName"  column="rule_name"  />
        <result property="ruleType"  column="rule_type"  />
        <result property="ruleValue" column="rule_value" />
        <result property="ruleOrder" column="rule_order" />
        <result property="status"    column="status"     />
        <result property="remark"    column="remark"     />
        <result property="createBy"  column="create_by"  />
        <result property="createTime" column="create_time"/>
        <result property="updateBy"  column="update_by"  />
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectEmployeeCodeRuleVo">
        select rule_id, rule_name, rule_type, rule_value, rule_order, status, remark, create_by, create_time, update_by, update_time
        from hrs_employee_code_rule
    </sql>

    <select id="selectEmployeeCodeRuleList" parameterType="EmployeeCodeRule" resultMap="EmployeeCodeRuleResult">
        <include refid="selectEmployeeCodeRuleVo"/>
        <where>  
            <if test="ruleName != null  and ruleName != ''"> and rule_name like concat('%', #{ruleName}, '%')</if>
            <if test="ruleType != null  and ruleType != ''"> and rule_type = #{ruleType}</if>
            <if test="ruleValue != null  and ruleValue != ''"> and rule_value = #{ruleValue}</if>
            <if test="ruleOrder != null "> and rule_order = #{ruleOrder}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by rule_order asc
    </select>
    
    <select id="selectEmployeeCodeRuleByRuleId" parameterType="Long" resultMap="EmployeeCodeRuleResult">
        <include refid="selectEmployeeCodeRuleVo"/>
        where rule_id = #{ruleId}
    </select>
        
    <insert id="insertEmployeeCodeRule" parameterType="EmployeeCodeRule" useGeneratedKeys="true" keyProperty="ruleId">
        insert into hrs_employee_code_rule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="ruleName != null">rule_name,</if>
            <if test="ruleType != null">rule_type,</if>
            <if test="ruleValue != null">rule_value,</if>
            <if test="ruleOrder != null">rule_order,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="ruleName != null">#{ruleName},</if>
            <if test="ruleType != null">#{ruleType},</if>
            <if test="ruleValue != null">#{ruleValue},</if>
            <if test="ruleOrder != null">#{ruleOrder},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEmployeeCodeRule" parameterType="EmployeeCodeRule">
        update hrs_employee_code_rule
        <trim prefix="SET" suffixOverrides=",">
            <if test="ruleName != null">rule_name = #{ruleName},</if>
            <if test="ruleType != null">rule_type = #{ruleType},</if>
            <if test="ruleValue != null">rule_value = #{ruleValue},</if>
            <if test="ruleOrder != null">rule_order = #{ruleOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where rule_id = #{ruleId}
    </update>

    <delete id="deleteEmployeeCodeRuleByRuleId" parameterType="Long">
        delete from hrs_employee_code_rule where rule_id = #{ruleId}
    </delete>

    <delete id="deleteEmployeeCodeRuleByRuleIds" parameterType="String">
        delete from hrs_employee_code_rule where rule_id in 
        <foreach item="ruleId" collection="array" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>
</mapper> 