<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.henglee.hrp.hrs.attendance.mapper.HrsAttendanceScheduleMapper">
    
    <resultMap type="HrsAttendanceSchedule" id="HrsAttendanceScheduleResult">
        <result property="scheduleId"    column="schedule_id"    />
        <result property="employeeId"    column="employee_id"    />
        <result property="employeeName"  column="employee_name"  />
        <result property="deptId"        column="dept_id"        />
        <result property="deptName"      column="dept_name"      />
        <result property="scheduleDate"  column="schedule_date"  />
        <result property="shiftId"       column="shift_id"       />
        <result property="shiftName"     column="shift_name"     />
        <result property="startTime"     column="start_time"     />
        <result property="endTime"       column="end_time"       />
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectHrsAttendanceScheduleVo">
        select schedule_id, employee_id, employee_name, dept_id, dept_name, schedule_date, shift_id, shift_name, start_time, end_time, status, del_flag, create_by, create_time, update_by, update_time, remark
        from hrs_attendance_schedule
    </sql>

    <select id="selectHrsAttendanceScheduleList" parameterType="HrsAttendanceSchedule" resultMap="HrsAttendanceScheduleResult">
        <include refid="selectHrsAttendanceScheduleVo"/>
        <where>  
            <if test="employeeId != null "> and employee_id = #{employeeId}</if>
            <if test="employeeName != null  and employeeName != ''"> and employee_name like concat('%', #{employeeName}, '%')</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="deptName != null  and deptName != ''"> and dept_name like concat('%', #{deptName}, '%')</if>
            <if test="scheduleDate != null "> and schedule_date = #{scheduleDate}</if>
            <if test="shiftId != null "> and shift_id = #{shiftId}</if>
            <if test="shiftName != null  and shiftName != ''"> and shift_name like concat('%', #{shiftName}, '%')</if>
            <if test="startTime != null "> and start_time = #{startTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            and del_flag = '0'
        </where>
        order by schedule_date desc, start_time asc
    </select>
    
    <select id="selectHrsAttendanceScheduleByScheduleId" parameterType="Long" resultMap="HrsAttendanceScheduleResult">
        <include refid="selectHrsAttendanceScheduleVo"/>
        where schedule_id = #{scheduleId} and del_flag = '0'
    </select>
        
    <insert id="insertHrsAttendanceSchedule" parameterType="HrsAttendanceSchedule" useGeneratedKeys="true" keyProperty="scheduleId">
        insert into hrs_attendance_schedule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">employee_id,</if>
            <if test="employeeName != null">employee_name,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="deptName != null">dept_name,</if>
            <if test="scheduleDate != null">schedule_date,</if>
            <if test="shiftId != null">shift_id,</if>
            <if test="shiftName != null">shift_name,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">#{employeeId},</if>
            <if test="employeeName != null">#{employeeName},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="deptName != null">#{deptName},</if>
            <if test="scheduleDate != null">#{scheduleDate},</if>
            <if test="shiftId != null">#{shiftId},</if>
            <if test="shiftName != null">#{shiftName},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateHrsAttendanceSchedule" parameterType="HrsAttendanceSchedule">
        update hrs_attendance_schedule
        <trim prefix="SET" suffixOverrides=",">
            <if test="employeeId != null">employee_id = #{employeeId},</if>
            <if test="employeeName != null">employee_name = #{employeeName},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="deptName != null">dept_name = #{deptName},</if>
            <if test="scheduleDate != null">schedule_date = #{scheduleDate},</if>
            <if test="shiftId != null">shift_id = #{shiftId},</if>
            <if test="shiftName != null">shift_name = #{shiftName},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where schedule_id = #{scheduleId}
    </update>

    <delete id="deleteHrsAttendanceScheduleByScheduleId" parameterType="Long">
        update hrs_attendance_schedule set del_flag = '2' where schedule_id = #{scheduleId}
    </delete>

    <delete id="deleteHrsAttendanceScheduleByScheduleIds" parameterType="String">
        update hrs_attendance_schedule set del_flag = '2' where schedule_id in 
        <foreach item="scheduleId" collection="array" open="(" separator="," close=")">
            #{scheduleId}
        </foreach>
    </delete>
</mapper> 