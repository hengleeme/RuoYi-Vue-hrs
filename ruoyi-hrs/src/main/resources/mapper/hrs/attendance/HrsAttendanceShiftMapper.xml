<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.henglee.hrp.hrs.attendance.mapper.HrsAttendanceShiftMapper">
    
    <resultMap type="HrsAttendanceShift" id="HrsAttendanceShiftResult">
        <result property="shiftId"    column="shift_id"    />
        <result property="shiftName"    column="shift_name"    />
        <result property="shiftType"    column="shift_type"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="lateThreshold"    column="late_threshold"    />
        <result property="earlyThreshold"    column="early_threshold"    />
        <result property="absentThreshold"    column="absent_threshold"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectHrsAttendanceShiftVo">
        select shift_id, shift_name, shift_type, start_time, end_time, late_threshold, early_threshold, absent_threshold, status, del_flag, create_by, create_time, update_by, update_time, remark from hrs_attendance_shift
    </sql>

    <select id="selectHrsAttendanceShiftList" parameterType="HrsAttendanceShift" resultMap="HrsAttendanceShiftResult">
        <include refid="selectHrsAttendanceShiftVo"/>
        <where>  
            <if test="shiftName != null  and shiftName != ''"> and shift_name like concat('%', #{shiftName}, '%')</if>
            <if test="shiftType != null  and shiftType != ''"> and shift_type = #{shiftType}</if>
            <if test="startTime != null "> and start_time = #{startTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="lateThreshold != null "> and late_threshold = #{lateThreshold}</if>
            <if test="earlyThreshold != null "> and early_threshold = #{earlyThreshold}</if>
            <if test="absentThreshold != null "> and absent_threshold = #{absentThreshold}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectHrsAttendanceShiftByShiftId" parameterType="Long" resultMap="HrsAttendanceShiftResult">
        <include refid="selectHrsAttendanceShiftVo"/>
        where shift_id = #{shiftId}
    </select>
        
    <insert id="insertHrsAttendanceShift" parameterType="HrsAttendanceShift" useGeneratedKeys="true" keyProperty="shiftId">
        insert into hrs_attendance_shift
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="shiftName != null">shift_name,</if>
            <if test="shiftType != null">shift_type,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="lateThreshold != null">late_threshold,</if>
            <if test="earlyThreshold != null">early_threshold,</if>
            <if test="absentThreshold != null">absent_threshold,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="shiftName != null">#{shiftName},</if>
            <if test="shiftType != null">#{shiftType},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="lateThreshold != null">#{lateThreshold},</if>
            <if test="earlyThreshold != null">#{earlyThreshold},</if>
            <if test="absentThreshold != null">#{absentThreshold},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateHrsAttendanceShift" parameterType="HrsAttendanceShift">
        update hrs_attendance_shift
        <trim prefix="SET" suffixOverrides=",">
            <if test="shiftName != null">shift_name = #{shiftName},</if>
            <if test="shiftType != null">shift_type = #{shiftType},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="lateThreshold != null">late_threshold = #{lateThreshold},</if>
            <if test="earlyThreshold != null">early_threshold = #{earlyThreshold},</if>
            <if test="absentThreshold != null">absent_threshold = #{absentThreshold},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where shift_id = #{shiftId}
    </update>

    <delete id="deleteHrsAttendanceShiftByShiftId" parameterType="Long">
        delete from hrs_attendance_shift where shift_id = #{shiftId}
    </delete>

    <delete id="deleteHrsAttendanceShiftByShiftIds" parameterType="String">
        delete from hrs_attendance_shift where shift_id in 
        <foreach item="shiftId" collection="array" open="(" separator="," close=")">
            #{shiftId}
        </foreach>
    </delete>
</mapper> 