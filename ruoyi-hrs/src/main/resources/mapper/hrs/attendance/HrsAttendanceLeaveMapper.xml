<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.henglee.hrp.hrs.attendance.mapper.HrsAttendanceLeaveMapper">
    
    <resultMap type="HrsAttendanceLeave" id="HrsAttendanceLeaveResult">
        <result property="leaveId"    column="leave_id"    />
        <result property="employeeId"    column="employee_id"    />
        <result property="employeeName"    column="employee_name"    />
        <result property="deptId"    column="dept_id"    />
        <result property="deptName"    column="dept_name"    />
        <result property="leaveType"    column="leave_type"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="leaveHours"    column="leave_hours"    />
        <result property="leaveReason"    column="leave_reason"    />
        <result property="status"    column="status"    />
        <result property="approver"    column="approver"    />
        <result property="approveTime"    column="approve_time"    />
        <result property="approveComment"    column="approve_comment"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectHrsAttendanceLeaveVo">
        select leave_id, employee_id, employee_name, dept_id, dept_name, leave_type, start_time, end_time, leave_hours, leave_reason, status, approver, approve_time, approve_comment, del_flag, create_by, create_time, update_by, update_time, remark from hrs_attendance_leave
    </sql>

    <select id="selectHrsAttendanceLeaveList" parameterType="HrsAttendanceLeave" resultMap="HrsAttendanceLeaveResult">
        <include refid="selectHrsAttendanceLeaveVo"/>
        <where>  
            <if test="employeeName != null  and employeeName != ''"> and employee_name like concat('%', #{employeeName}, '%')</if>
            <if test="deptName != null  and deptName != ''"> and dept_name like concat('%', #{deptName}, '%')</if>
            <if test="leaveType != null  and leaveType != ''"> and leave_type = #{leaveType}</if>
            <if test="startTime != null "> and start_time &gt;= #{startTime}</if>
            <if test="endTime != null "> and end_time &lt;= #{endTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="approver != null  and approver != ''"> and approver = #{approver}</if>
            and del_flag = '0'
        </where>
        order by create_time desc
    </select>
    
    <select id="selectHrsAttendanceLeaveByLeaveId" parameterType="Long" resultMap="HrsAttendanceLeaveResult">
        <include refid="selectHrsAttendanceLeaveVo"/>
        where leave_id = #{leaveId} and del_flag = '0'
    </select>
        
    <insert id="insertHrsAttendanceLeave" parameterType="HrsAttendanceLeave" useGeneratedKeys="true" keyProperty="leaveId">
        insert into hrs_attendance_leave
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">employee_id,</if>
            <if test="employeeName != null">employee_name,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="deptName != null">dept_name,</if>
            <if test="leaveType != null">leave_type,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="leaveHours != null">leave_hours,</if>
            <if test="leaveReason != null">leave_reason,</if>
            <if test="status != null">status,</if>
            <if test="approver != null">approver,</if>
            <if test="approveTime != null">approve_time,</if>
            <if test="approveComment != null">approve_comment,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="employeeId != null">#{employeeId},</if>
            <if test="employeeName != null">#{employeeName},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="deptName != null">#{deptName},</if>
            <if test="leaveType != null">#{leaveType},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="leaveHours != null">#{leaveHours},</if>
            <if test="leaveReason != null">#{leaveReason},</if>
            <if test="status != null">#{status},</if>
            <if test="approver != null">#{approver},</if>
            <if test="approveTime != null">#{approveTime},</if>
            <if test="approveComment != null">#{approveComment},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateHrsAttendanceLeave" parameterType="HrsAttendanceLeave">
        update hrs_attendance_leave
        <trim prefix="SET" suffixOverrides=",">
            <if test="employeeId != null">employee_id = #{employeeId},</if>
            <if test="employeeName != null">employee_name = #{employeeName},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="deptName != null">dept_name = #{deptName},</if>
            <if test="leaveType != null">leave_type = #{leaveType},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="leaveHours != null">leave_hours = #{leaveHours},</if>
            <if test="leaveReason != null">leave_reason = #{leaveReason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="approver != null">approver = #{approver},</if>
            <if test="approveTime != null">approve_time = #{approveTime},</if>
            <if test="approveComment != null">approve_comment = #{approveComment},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where leave_id = #{leaveId}
    </update>

    <delete id="deleteHrsAttendanceLeaveByLeaveId" parameterType="Long">
        update hrs_attendance_leave set del_flag = '2' where leave_id = #{leaveId}
    </delete>

    <delete id="deleteHrsAttendanceLeaveByLeaveIds" parameterType="String">
        update hrs_attendance_leave set del_flag = '2' where leave_id in 
        <foreach item="leaveId" collection="array" open="(" separator="," close=")">
            #{leaveId}
        </foreach>
    </delete>
</mapper> 