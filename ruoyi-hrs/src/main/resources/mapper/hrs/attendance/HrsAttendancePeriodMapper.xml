<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.henglee.hrp.hrs.attendance.mapper.HrsAttendancePeriodMapper">
    
    <resultMap type="HrsAttendancePeriod" id="HrsAttendancePeriodResult">
        <result property="periodId"    column="period_id"    />
        <result property="periodName"    column="period_name"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="submitStartTime"    column="submit_start_time"    />
        <result property="submitEndTime"    column="submit_end_time"    />
        <result property="remindTime"    column="remind_time"    />
        <result property="remindRoleIds"    column="remind_role_ids"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectHrsAttendancePeriodVo">
        select period_id, period_name, start_date, end_date, submit_start_time, submit_end_time, remind_time, remind_role_ids, status, del_flag, create_by, create_time, update_by, update_time, remark from hrs_attendance_period
    </sql>

    <select id="selectHrsAttendancePeriodList" parameterType="HrsAttendancePeriod" resultMap="HrsAttendancePeriodResult">
        <include refid="selectHrsAttendancePeriodVo"/>
        <where>  
            <if test="periodName != null  and periodName != ''"> and period_name like concat('%', #{periodName}, '%')</if>
            <if test="startDate != null "> and start_date = #{startDate}</if>
            <if test="endDate != null "> and end_date = #{endDate}</if>
            <if test="submitStartTime != null "> and submit_start_time = #{submitStartTime}</if>
            <if test="submitEndTime != null "> and submit_end_time = #{submitEndTime}</if>
            <if test="remindTime != null "> and remind_time = #{remindTime}</if>
            <if test="remindRoleIds != null  and remindRoleIds != ''"> and remind_role_ids = #{remindRoleIds}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectHrsAttendancePeriodByPeriodId" parameterType="Long" resultMap="HrsAttendancePeriodResult">
        <include refid="selectHrsAttendancePeriodVo"/>
        where period_id = #{periodId}
    </select>
        
    <insert id="insertHrsAttendancePeriod" parameterType="HrsAttendancePeriod" useGeneratedKeys="true" keyProperty="periodId">
        insert into hrs_attendance_period
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="periodName != null">period_name,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="submitStartTime != null">submit_start_time,</if>
            <if test="submitEndTime != null">submit_end_time,</if>
            <if test="remindTime != null">remind_time,</if>
            <if test="remindRoleIds != null">remind_role_ids,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="periodName != null">#{periodName},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="submitStartTime != null">#{submitStartTime},</if>
            <if test="submitEndTime != null">#{submitEndTime},</if>
            <if test="remindTime != null">#{remindTime},</if>
            <if test="remindRoleIds != null">#{remindRoleIds},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateHrsAttendancePeriod" parameterType="HrsAttendancePeriod">
        update hrs_attendance_period
        <trim prefix="SET" suffixOverrides=",">
            <if test="periodName != null">period_name = #{periodName},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="submitStartTime != null">submit_start_time = #{submitStartTime},</if>
            <if test="submitEndTime != null">submit_end_time = #{submitEndTime},</if>
            <if test="remindTime != null">remind_time = #{remindTime},</if>
            <if test="remindRoleIds != null">remind_role_ids = #{remindRoleIds},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where period_id = #{periodId}
    </update>

    <delete id="deleteHrsAttendancePeriodByPeriodId" parameterType="Long">
        delete from hrs_attendance_period where period_id = #{periodId}
    </delete>

    <delete id="deleteHrsAttendancePeriodByPeriodIds" parameterType="String">
        delete from hrs_attendance_period where period_id in 
        <foreach item="periodId" collection="array" open="(" separator="," close=")">
            #{periodId}
        </foreach>
    </delete>
</mapper> 